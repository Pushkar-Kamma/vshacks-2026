# Copy this file to ".env" and fill in your keys. NEVER commit the real .env.
#
# Featherless.ai is a hackathon sponsor with an OpenAI-compatible API. If we use
# AI, grab a key and put it here. In code, read it with:
#     import.meta.env.VITE_FEATHERLESS_API_KEY
#
# WARNING: anything with the VITE_ prefix is bundled into the public website, so
# it is NOT secret. For a real secret key you'd need a small backend to hide it.
VITE_FEATHERLESS_API_KEY=
