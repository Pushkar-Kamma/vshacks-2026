{
  "name": "vsHacks 2026",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm install",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "dsznajder.es7-react-js-snippets",
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}
